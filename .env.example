# =============================================================================
# Sharjah Safari Transport Management System — environment variable template
#
# Copy to .env.local and fill in the values from your Supabase project
# (Project Settings > API Keys). NEVER commit .env.local or real keys.
#
#   NEXT_PUBLIC_*  -> bundled into the browser. Public by design, protected
#                     by Row Level Security.
#   no prefix      -> server-only. Must never reach client code.
# =============================================================================

# Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key. Safe to expose to the browser; all access is constrained
# by Row Level Security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key. BYPASSES Row Level Security — server-side use only, read
# exclusively by src/lib/supabase/admin.ts ("server-only"). Never add a
# NEXT_PUBLIC_ prefix to this and never reference it from a client component.
SUPABASE_SECRET_KEY=
